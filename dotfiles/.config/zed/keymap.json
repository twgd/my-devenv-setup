// Zed keymap — ported from vscode/keybindings.json and the
// vim.normalModeKeyBindingsNonRecursive / vim.insertModeKeyBindings
// blocks in vscode/settings.json.
//
// Zed's vim mode has no direct equivalent to VS Code's "before/after"
// remap syntax, so multi-key remaps are ported via vim::SendKeystrokes,
// which replays a literal keystroke string as if you'd typed it in
// normal/visual mode.
[
  {
    "context": "vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore",
    },
  },
  {
    "context": "AcpThread",
    "unbind": {
      "cmd-shift-g": "agent::SelectPreviousThreadMatch",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "cmd-shift-g": "search::SelectPreviousMatch",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-g": "git_panel::ToggleFocus",
    },
  },
]
